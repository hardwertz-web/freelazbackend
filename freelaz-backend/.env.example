# Copie este arquivo para ".env" e preencha com seus valores reais.
# O ".env" NUNCA deve ser commitado no Git (adicione ao .gitignore).

# String de conexão do Postgres. Se usar Neon.tech ou Supabase (grátis),
# cole aqui a "Connection string" que eles geram para você.
DATABASE_URL="postgresql://usuario:senha@host:5432/freelaz?sslmode=require"
# Neon: URL direta (sem -pooler) para prisma migrate; runtime usa DATABASE_URL (pooled)
DIRECT_URL=""

# ---- Provedor de pagamento: ASAAS ----
# (migração Mercado Pago -> Asaas: a transferência Pix para terceiros é API
# autoatendível em conta padrão — ver findings.md)

# Sandbox: https://sandbox.asaas.com/api/v3 — Produção: https://api.asaas.com/v3
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"

# Credencial da conta Asaas (crie em dashboard.asaas.com > Configurações >
# API > Chaves de acesso). Sandbox usa a chave da conta de teste (começa com
# "$aact_sandbox_"). Sem ela as rotas de cobrança respondem 503.
ASAAS_API_KEY="$aact_sandbox_SUBSTITUA"

# Token do webhook (painel do Asaas > Integrações > Webhooks). A rota
# /api/webhooks/asaas recusa qualquer notificação sem esse token — é a trava
# contra notificação forjada. Gere um valor longo e aleatório.
ASAAS_WEBHOOK_TOKEN="gere-um-valor-longo-e-aleatorio"

# Segredo das rotas internas (ex: /api/payouts/release, /api/admin/*) — em
# produção é OBRIGATÓRIO; em desenvolvimento local pode ficar vazio.
INTERNAL_API_SECRET="gere-um-valor-livre-aqui"

# Opcional: pasta onde ficam os arquivos enviados (documento, selfie,
# currículo, portfólio, evidências de disputa). Se vazio, usa "<raiz do projeto>/uploads".
# UPLOAD_DIR="C:/freelaz-uploads"

# ---- Agendador de jobs (Etapa 3.2) ----

# Token DEDICADO das rotas /api/jobs/*/run (códigos de turno, repasse semanal,
# reconciliação diária). É separado do INTERNAL_API_SECRET de propósito: vazar
# o token do agendador não dá acesso ao painel admin, e vice-versa.
# OBRIGATÓRIO em produção (≥32 caracteres ALEATÓRIOS). Sem ele, as rotas
# respondem 401 — nunca há caminho que contorne a validação em produção.
# Gere com, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOBS_RUN_TOKEN=""

# ESCAPE HATCH SÓ PARA DEV/TESTE: com "1" e SEM JOBS_RUN_TOKEN, as rotas de
# job ficam abertas em desenvolvimento. Deixe "1" EXCLUSIVAMENTE em dev local.
# 🔒 PROIBIDO EM PRODUÇÃO: com NODE_ENV=production e JOBS_ALLOW_UNTOKEN=1 o app
# NÃO SOBE (ver src/instrumentation.ts -> assertJobsAllowUntokenSafe). É de
# propósito: abriria o repasse semanal sem token.
JOBS_ALLOW_UNTOKEN=""

# ---- Fase 3 (dinheiro) ----

# Provedor de SANDBOX do repasse Pix: confirma a transferência sem mover
# dinheiro, só para validar o fluxo em dev/teste. Deixe "0" (ou ausente) para
# usar o provedor real (API /transfers do Asaas). Em produção é sempre ignorado.
PAYOUT_SANDBOX="0"

# Taxa do saque instantâneo, em pontos-base (100 = 1%). PLACEHOLDER — confirmar
# o valor com o produto antes de ir ao ar. Fase 5 torna isso editável pelo admin.
INSTANT_WITHDRAWAL_FEE_BPS="100"

# ---- Subcontas Asaas (Etapa 7.3a — FUNDAÇÃO) ----

# Feature flag do fluxo de subcontas (onboarding/split/payout). Default OFF:
# na 7.3a só existem schema + helpers em src/lib/asaas.ts, nada os chama em
# produção. Ligue apenas quando 7.3b/c/d estiverem implementadas e validadas.
# Observação: subcontas novas no Asaas passam pelo período de avaliação
# regulatória e começam com limites reduzidos.
ASAAS_SUBACCOUNT_ENABLED="false"

# ---- Payout via subconta (Etapa 7.3d - SCAFFOLD) ----
# Default OFF. A funcao pura resolvePayoutOrigin() existe, mas NAO e chamada
# por nenhum fluxo de execucao: com OFF (ou sem apiKey da subconta) o repasse
# continua saindo da conta principal e nenhum dinheiro se move por causa desta
# flag. Ligue apenas quando a 7.3d for implementada e validada.
PAYOUT_FROM_SUBACCOUNT_ENABLED="false"

# ---- Modelo de taxa (Etapa 7.3d) ----
# Default OFF. OFF = LEGACY (historico): o profissional recebe o liquido
# (bruto - 10%) e a empresa paga apenas o bruto. ON = NEW: o profissional
# recebe 100% do bruto e a empresa paga bruto + comissao de 10% + taxa de
# saque estimada (custodia na conta principal; SEM split/subcontas).
# O modelo novo so deve ser ligado apos validacao contabil/regulatoria.
TAX_MODEL_NEW="false"

# ---- IA de cadastro (pré-triagem OCR local) ----
# Default OFF. Nunca decide sozinha: classifica AUTO_OK vs REVIEW.
# Admin só vê REVIEW. NÃO integrar com aprovação automática nesta sessão.
DOCUMENT_AI_ENABLED="false"
