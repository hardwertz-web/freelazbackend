# Copie este arquivo para ".env" e preencha com seus valores reais.
# O ".env" NUNCA deve ser commitado no Git (adicione ao .gitignore).

# String de conexão do Postgres. Se usar Neon.tech ou Supabase (grátis),
# cole aqui a "Connection string" que eles geram para você.
DATABASE_URL="postgresql://usuario:senha@host:5432/freelaz?sslmode=require"

# ---- Provedor de pagamento: ASAAS ----
# (migração Mercado Pago -> Asaas: a transferência Pix para terceiros é API
# autoatendível em conta padrão — ver findings.md)

# Sandbox: https://sandbox.asaas.com/api/v3 — Produção: https://api.asaas.com/v3
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"

# Credencial da conta Asaas (crie em dashboard.asaas.com > Configurações >
# API > Chaves de acesso). Sandbox usa a chave da conta de teste (começa com
# "$aact_sandbox_"). Sem ela as rotas de cobrança respondem 503.
ASAAS_API_KEY="$aact_sandbox_SUBSTITUA"

# Token do webhook (painel do Asaas > Integrações > Webhooks). A rota
# /api/webhooks/asaas recusa qualquer notificação sem esse token — é a trava
# contra notificação forjada. Gere um valor longo e aleatório.
ASAAS_WEBHOOK_TOKEN="gere-um-valor-longo-e-aleatorio"

# Segredo das rotas internas (ex: /api/payouts/release, /api/admin/*) — em
# produção é OBRIGATÓRIO; em desenvolvimento local pode ficar vazio.
INTERNAL_API_SECRET="gere-um-valor-livre-aqui"

# Opcional: pasta onde ficam os arquivos enviados (documento, selfie,
# currículo, portfólio, evidências de disputa). Se vazio, usa "<raiz do projeto>/uploads".
# UPLOAD_DIR="C:/freelaz-uploads"

# ---- Fase 3 (dinheiro) ----

# Provedor de SANDBOX do repasse Pix: confirma a transferência sem mover
# dinheiro, só para validar o fluxo em dev/teste. Deixe "0" (ou ausente) para
# usar o provedor real (API /transfers do Asaas). Em produção é sempre ignorado.
PAYOUT_SANDBOX="0"

# Taxa do saque instantâneo, em pontos-base (100 = 1%). PLACEHOLDER — confirmar
# o valor com o produto antes de ir ao ar. Fase 5 torna isso editável pelo admin.
INSTANT_WITHDRAWAL_FEE_BPS="100"
